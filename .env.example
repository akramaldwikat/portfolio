# Required for production canonical URLs, sitemap, and contact origin checks.
NEXT_PUBLIC_SITE_URL=https://your-owned-domain.com
# Omit unavailable links. Never use invented profiles.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=
# Optional E.164 override. Akram's supplied public WhatsApp number is the default.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_FLOWDESK_GITHUB_URL=
NEXT_PUBLIC_FLOWDESK_DEMO_URL=
# Form stays disabled until ALL delivery settings below and the real site URL are set.
# Rebuild after changing configuration, including server-only delivery settings.
# Contact delivery: Resend API key, verified sender and recipient. Server-only.
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=
# Required shared quota: five valid attempts per IP per ten minutes across instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
